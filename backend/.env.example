# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# PostgreSQL local de `docker compose up -d db` (puerto 5433 del host).
# En producción: postgresql+psycopg://usuario:contraseña@host:5432/shopagent
DATABASE_URL=postgresql+psycopg://shopagent:shopagent@localhost:5433/shopagent

# Base de datos de los tests (la crea el contenedor la primera vez que arranca).
TEST_DATABASE_URL=postgresql+psycopg://shopagent:shopagent@localhost:5433/shopagent_test
