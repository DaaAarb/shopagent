# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repo.

# PostgreSQL local de `docker compose up -d db` (puerto 5433 del host).
# En producción: postgresql+psycopg://usuario:contraseña@host:5432/shopagent
DATABASE_URL=postgresql+psycopg://darb:shopagent123@localhost:5433/shopagentPG

# Base de datos de los tests (la crea el contenedor la primera vez que arranca).
TEST_DATABASE_URL=postgresql+psycopg://darb:shopagent123@localhost:5433/shopagent_test

# API key de Gemini (https://aistudio.google.com/apikey). Solo la necesita /chat.
GEMINI_API_KEY=
# Modelo del agente (debe soportar function calling).
LLM_MODEL=gemini-3.5-flash

# Redis local de `docker compose up -d redis`: historial del chat y acciones pendientes.
REDIS_URL=redis://localhost:6380/0

# Clave que firma las sesiones (JWT). OBLIGATORIA y secreta: quien la tenga puede
# fabricar sesiones de cualquier usuario. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# true en producción (HTTPS): la cookie de sesión solo viaja cifrada.
COOKIE_SECURE=false
